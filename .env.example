# Copy to .env for local work. On Render set the same names in Environment. Never commit real values.

ANTHROPIC_API_KEY=

# Database file. On Render use a persistent disk path, e.g. /var/data/app.db
DB_PATH=

# Admin/test accounts that always have PRO (comma-separated usernames or e-mails)
PRO_USERS=

# --- Lemon Squeezy (subscriptions) ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Shown on the Subscribe button, e.g. $5/mo
PRO_PRICE_LABEL=
# Public site address used for the post-payment redirect (optional, auto-detected otherwise)
PUBLIC_URL=https://accounting-trainer.onrender.com
# Set to 1 while testing with Lemon Squeezy test mode
LEMON_SQUEEZY_TEST_MODE=

# --- Limits (optional, defaults shown) ---
# AI generations per PRO user per UTC day
PRO_DAILY_LIMIT=60
# Session token lifetime in days
SESSION_DAYS=30
# Failed logins per login name within the window before it is locked
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_SECONDS=900

# --- Email (verification + password reset) over SMTP ---
# Resend:  SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=<API key>
# Brevo:   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASSWORD=<SMTP key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address on a domain you verified with the provider
MAIL_FROM=Accounting Trainer <no-reply@yourdomain.com>
# Local development only: print the e-mails (with their links) to the console instead of sending
EMAIL_DEV_LOG=

# --- Ranked mode ---
# Secret that signs served tasks (the answer key travels inside the token). Use a long random string and keep it stable,
# otherwise tasks that are open in a browser stop working after a restart.
TASK_SECRET=
# Answers sent faster than this many seconds per point do not change the rating (default 1.2)
MIN_SECONDS_PER_POINT=

# Accounts that may set their own level for testing (comma-separated e-mails)
ADMIN_USERS=
